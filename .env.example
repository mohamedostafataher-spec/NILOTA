# NILORA Environment Configuration Template
# AI Studio injects configured secrets from the Secrets panel into BuildConfig at build time.
# Never commit actual API keys to source control.
#
# Note: Gemini AI & Multilingual Assistant use Firebase AI Logic + App Check (no GEMINI_API_KEY needed).
#
# Optional: Google Maps Platform / Places / Directions API Key (for live Places & Route Planning).
# Replace placeholder via AI Studio Secrets panel; app handles unconfigured state cleanly.
GOOGLE_MAPS_API_KEY=MY_GOOGLE_MAPS_API_KEY
