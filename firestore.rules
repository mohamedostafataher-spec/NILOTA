rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        ('email_verified' in request.auth.token &&
         request.auth.token.email_verified == true &&
         'email' in request.auth.token &&
         request.auth.token.email == 'mohamedostafataher@gmail.com')
      );
    }

    function isApprovedProvider(uid) {
      return exists(/databases/$(database)/documents/providers/$(uid)) &&
             get(/databases/$(database)/documents/providers/$(uid)).data.verificationStatus == 'APPROVED';
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isBoundedStringList(val, maxItems, maxItemLen) {
      return val is list && val.size() <= maxItems &&
             (val.size() == 0 || (val[0] is string && val[0].size() <= maxItemLen));
    }

    function pairDocId(uidA, uidB) {
      return uidA < uidB ? (uidA + '__' + uidB) : (uidB + '__' + uidA);
    }

    function isBlockedBetween(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/blocked/$(uidB)) ||
             exists(/databases/$(database)/documents/users/$(uidB)/blocked/$(uidA));
    }

    function isConnected(uidA, uidB) {
      return exists(/databases/$(database)/documents/direct_conversations/$(pairDocId(uidA, uidB)));
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) &&
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupModeratorOrOwner(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) && (
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.moderatorIds
      );
    }

    // --- VALIDATION HELPERS ---
    function isValidAdminUser(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.email, 3, 200) &&
             data.roleLevel in ['SUPER_ADMIN', 'MODERATOR', 'VERIFIER'] &&
             isValidTimestamp(data.createdAt);
    }

    function isValidUserProfile(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.displayName, 1, 80) &&
             data.accountMode in ['TRAVELER', 'LOCAL_PROVIDER', 'GLOBAL_MEMBER'] &&
             data.preferredLanguage in ['en', 'ar', 'fr', 'ru'] &&
             isBoundedString(data.country, 1, 80) &&
             (!('city' in data) || isBoundedString(data.city, 0, 80)) &&
             (!('nativeLanguage' in data) || isBoundedString(data.nativeLanguage, 1, 16)) &&
             (!('spokenLanguages' in data) || isBoundedStringList(data.spokenLanguages, 15, 20)) &&
             (!('learningLanguages' in data) || isBoundedStringList(data.learningLanguages, 15, 20)) &&
             (!('interests' in data) || isBoundedStringList(data.interests, 15, 40)) &&
             (!('profileVisibility' in data) || data.profileVisibility in ['PUBLIC', 'CONNECTIONS_ONLY', 'PRIVATE']) &&
             (!('openToLanguageExchange' in data) || data.openToLanguageExchange is bool) &&
             data.privacyConsent is bool &&
             (!('retainTranslationHistory' in data) || data.retainTranslationHistory is bool) &&
             (!('photoUri' in data) || isBoundedString(data.photoUri, 0, 1000)) &&
             (!('bio' in data) || isBoundedString(data.bio, 0, 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPublicProfile(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.displayName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             (!('city' in data) || isBoundedString(data.city, 0, 80)) &&
             isBoundedString(data.nativeLanguage, 1, 16) &&
             (!('spokenLanguages' in data) || isBoundedStringList(data.spokenLanguages, 15, 20)) &&
             (!('learningLanguages' in data) || isBoundedStringList(data.learningLanguages, 15, 20)) &&
             (!('interests' in data) || isBoundedStringList(data.interests, 15, 40)) &&
             (!('photoUri' in data) || isBoundedString(data.photoUri, 0, 1000)) &&
             (!('bio' in data) || isBoundedString(data.bio, 0, 500)) &&
             data.profileVisibility in ['PUBLIC', 'CONNECTIONS_ONLY', 'PRIVATE'] &&
             data.openToLanguageExchange is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserPrivateInfo(data) {
      return isBoundedString(data.userId, 1, 128) &&
             (!('email' in data) || isBoundedString(data.email, 0, 200)) &&
             (!('phoneCountryCode' in data) || isBoundedString(data.phoneCountryCode, 0, 10)) &&
             (!('phone' in data) || isBoundedString(data.phone, 0, 40)) &&
             (!('emergencyContact' in data) || isBoundedString(data.emergencyContact, 0, 160)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBlockedUser(data) {
      return isBoundedString(data.blockerId, 1, 128) &&
             isBoundedString(data.blockedUserId, 1, 128) &&
             data.blockerId != data.blockedUserId &&
             (!('blockedUserName' in data) || isBoundedString(data.blockedUserName, 0, 80)) &&
             (!('reason' in data) || isBoundedString(data.reason, 0, 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidConnectionRequest(data) {
      return isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             (!('senderCountry' in data) || isBoundedString(data.senderCountry, 0, 80)) &&
             (!('senderNativeLanguage' in data) || isBoundedString(data.senderNativeLanguage, 0, 16)) &&
             isBoundedString(data.receiverId, 1, 128) &&
             isBoundedString(data.receiverName, 1, 80) &&
             (!('receiverCountry' in data) || isBoundedString(data.receiverCountry, 0, 80)) &&
             (!('receiverNativeLanguage' in data) || isBoundedString(data.receiverNativeLanguage, 0, 16)) &&
             data.senderId != data.receiverId &&
             data.memberUids is list && data.memberUids.size() == 2 &&
             data.senderId in data.memberUids && data.receiverId in data.memberUids &&
             (!('introMessage' in data) || isBoundedString(data.introMessage, 0, 300)) &&
             data.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'CANCELLED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDirectConversation(data) {
      return data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.participantIds[0] != data.participantIds[1] &&
             data.participantNames is map &&
             (!('participantLanguages' in data) || data.participantLanguages is map) &&
             (!('lastMessagePreview' in data) || isBoundedString(data.lastMessagePreview, 0, 300)) &&
             (!('lastMessageSenderId' in data) || isBoundedString(data.lastMessageSenderId, 0, 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDirectMessage(data) {
      return isBoundedString(data.conversationId, 1, 260) &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             data.messageType in ['TEXT', 'VOICE_NOTE'] &&
             isBoundedString(data.originalText, 1, 2000) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationConfidence' in data) || isBoundedString(data.translationConfidence, 0, 16)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 95000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             (!('audioMimeType' in data) || isBoundedString(data.audioMimeType, 0, 40)) &&
             data.deliveryStatus in ['SENT', 'DELIVERED', 'READ'] &&
             isValidTimestamp(data.createdAt);
    }

    function isValidGroupRoom(data) {
      return isBoundedString(data.name, 2, 80) &&
             (!('description' in data) || isBoundedString(data.description, 0, 400)) &&
             isBoundedString(data.ownerId, 1, 128) &&
             isBoundedStringList(data.moderatorIds, 20, 128) &&
             isBoundedStringList(data.memberIds, 100, 128) &&
             isBoundedStringList(data.bannedIds, 100, 128) &&
             data.ownerId in data.memberIds &&
             (!('primaryLanguages' in data) || isBoundedStringList(data.primaryLanguages, 10, 16)) &&
             data.joinPolicy in ['OPEN', 'REQUEST_APPROVAL', 'INVITE_ONLY'] &&
             data.autoTranslateDefault is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroupJoinRequest(data) {
      return isBoundedString(data.groupId, 1, 128) &&
             isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.userName, 1, 80) &&
             (!('userCountry' in data) || isBoundedString(data.userCountry, 0, 80)) &&
             (!('nativeLanguage' in data) || isBoundedString(data.nativeLanguage, 0, 16)) &&
             (!('message' in data) || isBoundedString(data.message, 0, 300)) &&
             data.requestType in ['JOIN_REQUEST', 'INVITE'] &&
             data.status in ['PENDING', 'APPROVED', 'DECLINED'] &&
             (!('invitedBy' in data) || isBoundedString(data.invitedBy, 0, 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroupMessage(data) {
      return isBoundedString(data.groupId, 1, 128) &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             isBoundedString(data.originalText, 1, 2000) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFavoriteItem(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.targetId, 1, 128) &&
             data.targetType in ['DESTINATION', 'ACTIVITY', 'PROVIDER'] &&
             isBoundedString(data.title, 1, 140) &&
             (!('cityName' in data) || isBoundedString(data.cityName, 0, 80)) &&
             (!('category' in data) || isBoundedString(data.category, 0, 80)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidTravelNote(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.title, 1, 120) &&
             isBoundedString(data.content, 1, 2000) &&
             (!('cityName' in data) || isBoundedString(data.cityName, 0, 80)) &&
             (!('tripDate' in data) || isBoundedString(data.tripDate, 0, 40)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.title, 1, 120) &&
             isBoundedString(data.message, 1, 500) &&
             data.category in ['BOOKING', 'VERIFICATION', 'SYSTEM', 'TRANSLATION', 'COMMUNITY', 'GROUP', 'EXPERIENCE', 'ADVENTURE', 'REALITY'] &&
             data.readStatus is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidCountry(data) {
      return isBoundedString(data.code, 2, 10) &&
             isBoundedString(data.name, 1, 80) &&
             (!('nativeName' in data) || isBoundedString(data.nativeName, 0, 80)) &&
             isBoundedString(data.defaultCurrency, 1, 10) &&
             (!('supportedLanguages' in data) || isBoundedStringList(data.supportedLanguages, 20, 16)) &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCity(data) {
      return isBoundedString(data.countryCode, 2, 10) &&
             isBoundedString(data.name, 1, 80) &&
             (!('arabicName' in data) || isBoundedString(data.arabicName, 0, 80)) &&
             (!('region' in data) || isBoundedString(data.region, 0, 80)) &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDestination(data) {
      return isBoundedString(data.title, 2, 140) &&
             isBoundedString(data.countryCode, 2, 10) &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.category, 1, 60) &&
             isBoundedString(data.description, 1, 2000) &&
             data.verifiedCoordinates is bool &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             (!('facilities' in data) || isBoundedStringList(data.facilities, 30, 80)) &&
             (!('operatingHours' in data) || isBoundedString(data.operatingHours, 0, 200)) &&
             (!('priceInfo' in data) || isBoundedString(data.priceInfo, 0, 200)) &&
             (!('safetyWarnings' in data) || isBoundedString(data.safetyWarnings, 0, 500)) &&
             (!('accessibilityInfo' in data) || isBoundedString(data.accessibilityInfo, 0, 300)) &&
             (!('officialWebsite' in data) || isBoundedString(data.officialWebsite, 0, 300)) &&
             (!('contactInfo' in data) || isBoundedString(data.contactInfo, 0, 200)) &&
             (!('photoUrl' in data) || isBoundedString(data.photoUrl, 0, 500)) &&
             isBoundedString(data.sourceName, 1, 200) &&
             (!('sourceUrl' in data) || isBoundedString(data.sourceUrl, 0, 500)) &&
             (!('lastVerifiedAt' in data) || isBoundedString(data.lastVerifiedAt, 0, 60)) &&
             data.verificationStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             isBoundedString(data.submittedBy, 1, 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidActivity(data) {
      return isBoundedString(data.title, 2, 140) &&
             isBoundedString(data.providerId, 1, 128) &&
             isBoundedString(data.providerName, 1, 100) &&
             isBoundedString(data.countryCode, 2, 10) &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.category, 1, 60) &&
             isBoundedString(data.description, 1, 2000) &&
             isBoundedString(data.durationLabel, 1, 80) &&
             (!('priceAmount' in data) || (data.priceAmount is number && data.priceAmount >= 0)) &&
             (!('currency' in data) || isBoundedString(data.currency, 0, 10)) &&
             data.priceOnRequest is bool &&
             data.availabilityStatus in ['AVAILABLE', 'ON_REQUEST', 'UNAVAILABLE'] &&
             (!('includedServices' in data) || isBoundedStringList(data.includedServices, 25, 100)) &&
             (!('exclusions' in data) || isBoundedStringList(data.exclusions, 25, 100)) &&
             isBoundedString(data.cancellationPolicy, 1, 500) &&
             (!('safetyRequirements' in data) || isBoundedString(data.safetyRequirements, 0, 500)) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude <= 180 && data.longitude >= -180)) &&
             data.verifiedCoordinates is bool &&
             isBoundedString(data.sourceName, 1, 200) &&
             data.verificationStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProvider(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.fullName, 2, 100) &&
             data.serviceType in ['TOUR_GUIDE', 'TRANSLATOR', 'TRAVEL_ASSISTANT', 'TOUR_OPERATOR', 'HOSPITALITY'] &&
             isBoundedStringList(data.languages, 15, 24) &&
             isBoundedStringList(data.citiesCovered, 20, 80) &&
             isBoundedString(data.bio, 5, 1000) &&
             (!('licenseNumber' in data) || isBoundedString(data.licenseNumber, 0, 100)) &&
             isBoundedString(data.documentSummary, 3, 400) &&
             (!('documentRefUri' in data) || isBoundedString(data.documentRefUri, 0, 1000)) &&
             data.verificationStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             (!('reviewedBy' in data) || isBoundedString(data.reviewedBy, 0, 128)) &&
             (!('rejectionReason' in data) || isBoundedString(data.rejectionReason, 0, 300)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBooking(data) {
      return isBoundedString(data.bookingReference, 4, 40) &&
             isBoundedString(data.travelerId, 1, 128) &&
             isBoundedString(data.travelerName, 1, 100) &&
             isBoundedString(data.providerId, 1, 128) &&
             isBoundedString(data.providerName, 1, 100) &&
             isBoundedString(data.activityId, 1, 128) &&
             isBoundedString(data.activityTitle, 1, 140) &&
             isBoundedString(data.requestedDate, 4, 40) &&
             data.participantsCount is int && data.participantsCount >= 1 && data.participantsCount <= 50 &&
             (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
             data.status in ['REQUEST_SUBMITTED', 'AWAITING_PROVIDER_CONFIRMATION', 'CONFIRMED', 'REJECTED', 'CANCELLED'] &&
             (!('cancellationReason' in data) || isBoundedString(data.cancellationReason, 0, 300)) &&
             data.paymentStatus in ['NOT_CONFIGURED', 'PENDING', 'PAID', 'REFUNDED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidConversationRoom(data) {
      return isBoundedString(data.roomCode, 4, 24) &&
             isBoundedString(data.hostId, 1, 128) &&
             isBoundedString(data.hostName, 1, 80) &&
             data.hostLanguage in ['en', 'ar', 'fr', 'ru'] &&
             (!('guestId' in data) || isBoundedString(data.guestId, 0, 128)) &&
             (!('guestName' in data) || isBoundedString(data.guestName, 0, 80)) &&
             (!('guestLanguage' in data) || data.guestLanguage in ['en', 'ar', 'fr', 'ru']) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 2 &&
             (data.memberUids[0] is string) &&
             data.status in ['WAITING', 'ACTIVE', 'ENDED'] &&
             data.retainTranscript is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidConversationMessage(data) {
      return isBoundedString(data.roomCode, 4, 24) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 2 &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             data.sourceLanguage in ['en', 'ar', 'fr', 'ru'] &&
             data.targetLanguage in ['en', 'ar', 'fr', 'ru'] &&
             isBoundedString(data.originalText, 1, 1500) &&
             isBoundedString(data.translatedText, 1, 1500) &&
             (!('confidenceNote' in data) || isBoundedString(data.confidenceNote, 0, 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return isBoundedString(data.reporterId, 1, 128) &&
             data.targetType in ['PROVIDER', 'DESTINATION', 'ACTIVITY', 'ROOM', 'USER', 'MESSAGE', 'GROUP', 'GROUP_MESSAGE', 'POSTCARD', 'POSTCARD_CONTRIBUTION', 'CULTURE_SWAP', 'WORLD_QUEST', 'MEMORY', 'ADVENTURE_SESSION', 'CREW', 'REALITY_EVENT', 'REALITY_ACTIVITY', 'REALITY_MISSION', 'GLOBAL_CHALLENGE'] &&
             isBoundedString(data.targetId, 1, 200) &&
             isBoundedString(data.reason, 2, 160) &&
             (!('details' in data) || isBoundedString(data.details, 0, 1000)) &&
             data.status in ['OPEN', 'REVIEWED', 'RESOLVED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDataSource(data) {
      return isBoundedString(data.name, 2, 120) &&
             isBoundedString(data.providerType, 2, 60) &&
             data.status in ['ACTIVE', 'AWAITING_CREDENTIALS', 'UNAVAILABLE'] &&
             (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
             isBoundedString(data.updatedBy, 1, 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return isBoundedString(data.actorId, 1, 128) &&
             (!('actorEmail' in data) || isBoundedString(data.actorEmail, 0, 200)) &&
             isBoundedString(data.action, 2, 100) &&
             isBoundedString(data.targetCollection, 1, 80) &&
             (!('targetId' in data) || isBoundedString(data.targetId, 0, 128)) &&
             isBoundedString(data.summary, 2, 500) &&
             data.severity in ['INFO', 'WARNING', 'SECURITY'] &&
             isValidTimestamp(data.createdAt);
    }

    function isValidWorldPostcard(data) {
      return isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             (!('city' in data) || isBoundedString(data.city, 0, 80)) &&
             isBoundedString(data.languageCode, 1, 16) &&
             data.category in ['STORY', 'QUESTION', 'EXPRESSION', 'FOOD', 'DAILY_LIFE', 'TRADITION'] &&
             isBoundedString(data.title, 1, 120) &&
             isBoundedString(data.storyText, 1, 1500) &&
             (!('localExpression' in data) || isBoundedString(data.localExpression, 0, 300)) &&
             (!('questionPrompt' in data) || isBoundedString(data.questionPrompt, 0, 300)) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 100000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             isBoundedStringList(data.participantIds, 50, 128) &&
             isBoundedStringList(data.countriesChain, 50, 80) &&
             data.contributionsCount is int && data.contributionsCount >= 0 && data.contributionsCount <= 500 &&
             data.allowReplies is bool &&
             data.allowPrivateConnect is bool &&
             data.visibility in ['PUBLIC', 'CONNECTIONS_ONLY', 'PRIVATE'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPostcardContribution(data) {
      return isBoundedString(data.postcardId, 1, 128) &&
             isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             (!('city' in data) || isBoundedString(data.city, 0, 80)) &&
             isBoundedString(data.languageCode, 1, 16) &&
             isBoundedString(data.responseText, 1, 1500) &&
             (!('localExpression' in data) || isBoundedString(data.localExpression, 0, 300)) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 100000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             data.allowPrivateConnect is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidCultureSwap(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             isBoundedString(data.creatorCountry, 1, 80) &&
             isBoundedString(data.creatorLanguage, 1, 16) &&
             data.promptCategory in ['TEACH_PHRASE', 'MORNING_ROUTINE', 'FOOD_TRADITION', 'LOCAL_SECRET', 'MUSIC_SONG', 'EVERYDAY_TRADITION'] &&
             isBoundedString(data.promptText, 2, 400) &&
             data.participationMode in ['TWO_PERSON', 'GROUP'] &&
             data.maxParticipants is int && data.maxParticipants >= 2 && data.maxParticipants <= 20 &&
             isBoundedStringList(data.participantIds, 20, 128) &&
             data.participantNames is map && data.participantNames.size() <= 20 &&
             data.participantCountries is map && data.participantCountries.size() <= 20 &&
             data.entriesCount is int && data.entriesCount >= 0 && data.entriesCount <= 200 &&
             data.status in ['OPEN', 'EXCHANGED', 'COMPLETED'] &&
             data.allowPrivateConnect is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCultureSwapEntry(data) {
      return isBoundedString(data.swapId, 1, 128) &&
             isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             isBoundedString(data.languageCode, 1, 16) &&
             isBoundedString(data.contentText, 1, 1500) &&
             (!('expressionSample' in data) || isBoundedString(data.expressionSample, 0, 300)) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 100000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidWorldQuest(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             data.missionType in ['FIVE_SIMILARITIES', 'THREE_EXPRESSIONS', 'LOCAL_TRADITION', 'FOOD_STORY', 'EVERYDAY_COMPARE', 'CUSTOM'] &&
             isBoundedString(data.title, 2, 120) &&
             isBoundedString(data.objective, 4, 500) &&
             data.targetGoal is int && data.targetGoal >= 2 && data.targetGoal <= 50 &&
             isBoundedStringList(data.participantIds, 50, 128) &&
             isBoundedStringList(data.participantCountries, 50, 80) &&
             data.contributionsCount is int && data.contributionsCount >= 0 && data.contributionsCount <= 500 &&
             data.status in ['ACTIVE', 'COMPLETED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWorldQuestContribution(data) {
      return isBoundedString(data.questId, 1, 128) &&
             isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             isBoundedString(data.languageCode, 1, 16) &&
             isBoundedString(data.contentText, 1, 1500) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 100000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNiloraMemory(data) {
      return isBoundedString(data.ownerId, 1, 128) &&
             isBoundedString(data.ownerName, 1, 80) &&
             data.memoryType in ['WORLD_POSTCARD', 'CULTURE_SWAP', 'WORLD_QUEST', 'CONVERSATION', 'VOICE_MEMORY'] &&
             (!('sourceId' in data) || isBoundedString(data.sourceId, 0, 128)) &&
             isBoundedString(data.title, 1, 120) &&
             isBoundedString(data.summaryText, 1, 2000) &&
             isBoundedString(data.originalLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             isBoundedStringList(data.countries, 50, 80) &&
             isBoundedStringList(data.partnerIds, 50, 128) &&
             isBoundedStringList(data.partnerNames, 50, 80) &&
             (!('placeLabel' in data) || isBoundedString(data.placeLabel, 0, 120)) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             (!('audioBase64' in data) || isBoundedString(data.audioBase64, 0, 100000)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 30000)) &&
             data.retainAudioConsent is bool &&
             (data.retainAudioConsent == true || (!('audioBase64' in data) || data.audioBase64 == '')) &&
             data.visibility in ['PRIVATE', 'SHARED_WITH_PARTICIPANTS', 'PUBLIC'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLiveAdventureSession(data) {
      return isBoundedString(data.hostId, 1, 128) &&
             isBoundedString(data.hostName, 1, 80) &&
             isBoundedString(data.adventureId, 1, 80) &&
             isBoundedString(data.adventureTitle, 2, 120) &&
             isBoundedString(data.destinationName, 2, 100) &&
             data.mode in ['SOLO', 'JOIN_OTHERS', 'CREW_SESSION'] &&
             data.status in ['ACTIVE', 'ENDED'] &&
             data.maxParticipants is int && data.maxParticipants >= 1 && data.maxParticipants <= 12 &&
             isBoundedStringList(data.participantIds, 12, 128) &&
             data.participantNames is map && data.participantNames.size() <= 12 &&
             data.participantCountries is map && data.participantCountries.size() <= 12 &&
             data.participantLanguages is map && data.participantLanguages.size() <= 12 &&
             data.voicePreferred is bool &&
             data.experienceLevel in ['BEGINNER', 'INTERMEDIATE', 'EXPLORER'] &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 180 &&
             (!('availabilitySlot' in data) || isBoundedString(data.availabilitySlot, 0, 80)) &&
             (!('crewId' in data) || isBoundedString(data.crewId, 0, 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSessionParticipantPresence(data) {
      return isBoundedString(data.sessionId, 1, 128) &&
             isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.displayName, 1, 80) &&
             isBoundedString(data.country, 1, 80) &&
             isBoundedString(data.languageCode, 1, 16) &&
             data.posX is number && data.posX >= -200 && data.posX <= 200 &&
             data.posY is number && data.posY >= -80 && data.posY <= 80 &&
             data.posZ is number && data.posZ >= -200 && data.posZ <= 200 &&
             data.yawDeg is number && data.yawDeg >= -720 && data.yawDeg <= 720 &&
             (!('pointedPoiId' in data) || isBoundedString(data.pointedPoiId, 0, 80)) &&
             (!('pointedX' in data) || data.pointedX is number) &&
             (!('pointedY' in data) || data.pointedY is number) &&
             (!('pointedZ' in data) || data.pointedZ is number) &&
             data.voiceMuted is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSessionChatMessage(data) {
      return isBoundedString(data.sessionId, 1, 128) &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             isBoundedString(data.originalText, 1, 1500) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             (!('translationNote' in data) || isBoundedString(data.translationNote, 0, 240)) &&
             (!('discoveryPoiId' in data) || isBoundedString(data.discoveryPoiId, 0, 80)) &&
             isValidTimestamp(data.createdAt);
