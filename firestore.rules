    function isCrewMember(crewId) {
      return exists(/databases/$(database)/documents/nilora_crews/$(crewId)) &&
             request.auth.uid in get(/databases/$(database)/documents/nilora_crews/$(crewId)).data.memberIds;
    }

    // --- PHASE 2 REALITY CONNECTED UNIVERSE HELPERS ---

    function isValidRealityEvent(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             isBoundedString(data.title, 2, 140) &&
             data.category in ['CULTURAL', 'FESTIVAL', 'MUSIC', 'SPORTS', 'TOURNAMENT', 'COMMUNITY', 'EXHIBITION', 'CONFERENCE', 'TOURISM', 'OUTDOOR', 'EDUCATIONAL', 'SEASONAL'] &&
             isBoundedString(data.description, 2, 2000) &&
             isBoundedString(data.countryCode, 2, 10) &&
             isBoundedString(data.countryName, 1, 80) &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.venueName, 1, 140) &&
             data.hasVerifiedCoordinates is bool &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             isBoundedString(data.startDateIso, 4, 40) &&
             (!('endDateIso' in data) || isBoundedString(data.endDateIso, 0, 40)) &&
             (!('timeWindowLabel' in data) || isBoundedString(data.timeWindowLabel, 0, 80)) &&
             data.freeVerified is bool &&
             (!('priceNote' in data) || isBoundedString(data.priceNote, 0, 160)) &&
             isBoundedString(data.organizerName, 1, 120) &&
             data.organizerType in ['OFFICIAL_INSTITUTION', 'CULTURAL_CENTER', 'LOCAL_COMMUNITY', 'SPORTS_CLUB', 'USER_ORGANIZER', 'EXTERNAL_OPEN_SOURCE'] &&
             (!('officialUrl' in data) || isBoundedString(data.officialUrl, 0, 400)) &&
             (!('conditionsNote' in data) || isBoundedString(data.conditionsNote, 0, 400)) &&
             (!('safetyNote' in data) || isBoundedString(data.safetyNote, 0, 400)) &&
             data.ageMinimum is int && data.ageMinimum >= 0 && data.ageMinimum <= 99 &&
             data.verificationTier in ['ADMIN_VERIFIED', 'UNVERIFIED_USER_SUBMITTED', 'EXTERNAL_OPEN_SOURCE'] &&
             (!('lastVerifiedLabel' in data) || isBoundedString(data.lastVerifiedLabel, 0, 80)) &&
             data.status in ['UPCOMING', 'ACTIVE', 'CANCELLED', 'COMPLETED'] &&
             data.maxParticipants is int && data.maxParticipants >= 2 && data.maxParticipants <= 500 &&
             isBoundedStringList(data.participantIds, 200, 128) &&
             data.creatorId in data.participantIds &&
             data.participantNames is map && data.participantNames.size() <= 200 &&
             isBoundedStringList(data.pendingRequestIds, 100, 128) &&
             data.joinPolicy in ['OPEN', 'REQUEST_APPROVAL'] &&
             (!('linkedAdventureId' in data) || isBoundedString(data.linkedAdventureId, 0, 80)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRealityEventMessage(data) {
      return isBoundedString(data.eventId, 1, 128) &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             isBoundedString(data.originalText, 1, 1500) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             isValidTimestamp(data.createdAt);
    }

    function isEventParticipant(eventId) {
      return exists(/databases/$(database)/documents/reality_events/$(eventId)) &&
             request.auth.uid in get(/databases/$(database)/documents/reality_events/$(eventId)).data.participantIds;
    }

    function isValidTeamActivityPost(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             data.domain in ['GO_TOGETHER', 'PLAY_SPORTS', 'SOCIAL_GAME', 'ADVENTURE_OUTDOOR', 'COMMUNITY_IMPACT'] &&
             isBoundedString(data.subCategory, 2, 48) &&
             isBoundedString(data.title, 2, 140) &&
             isBoundedString(data.description, 2, 2000) &&
             isBoundedString(data.countryName, 1, 80) &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.publicMeetingSpot, 2, 140) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             isBoundedString(data.scheduledDateLabel, 2, 60) &&
             data.skillLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED', 'ALL_LEVELS'] &&
             (!('equipmentNote' in data) || isBoundedString(data.equipmentNote, 0, 300)) &&
             isBoundedString(data.safetyRules, 1, 400) &&
             data.ageMinimum is int && data.ageMinimum >= 13 && data.ageMinimum <= 99 &&
             data.joinPolicy in ['PUBLIC', 'REQUEST_APPROVAL', 'INVITE_ONLY'] &&
             data.teamStatus in ['LOOKING_FOR_PARTICIPANTS', 'GROUP_FORMING', 'GROUP_FULL', 'ACTIVITY_CONFIRMED', 'ACTIVITY_COMPLETED', 'ACTIVITY_CANCELLED'] &&
             data.maxParticipants is int && data.maxParticipants >= 2 && data.maxParticipants <= 50 &&
             isBoundedStringList(data.participantIds, 50, 128) &&
             data.creatorId in data.participantIds &&
             data.participantNames is map && data.participantNames.size() <= 50 &&
             isBoundedStringList(data.pendingRequestIds, 50, 128) &&
             isBoundedStringList(data.invitedUserIds, 50, 128) &&
             (!('impactOrganizationName' in data) || isBoundedString(data.impactOrganizationName, 0, 120)) &&
             data.impactVerifiedByAdmin is bool &&
             (!('linkedAdventureId' in data) || isBoundedString(data.linkedAdventureId, 0, 80)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidActivityGroupMessage(data) {
      return isBoundedString(data.activityId, 1, 128) &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             isBoundedString(data.originalText, 1, 1500) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             isValidTimestamp(data.createdAt);
    }

    function isActivityParticipant(activityId) {
      return exists(/databases/$(database)/documents/reality_activities/$(activityId)) &&
             request.auth.uid in get(/databases/$(database)/documents/reality_activities/$(activityId)).data.participantIds;
    }

    function isValidRealityMission(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             isBoundedString(data.templateType, 2, 48) &&
             data.executionMode in ['REAL_WORLD', 'VIRTUAL'] &&
             isBoundedString(data.title, 2, 120) &&
             isBoundedString(data.objective, 4, 500) &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.countryName, 1, 80) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             isBoundedString(data.safetyAndEcoRules, 2, 500) &&
             data.targetSteps is int && data.targetSteps >= 1 && data.targetSteps <= 30 &&
             isBoundedStringList(data.participantIds, 100, 128) &&
             data.submissionsCount is int && data.submissionsCount >= 0 && data.submissionsCount <= 500 &&
             data.status in ['ACTIVE', 'COMPLETED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMissionSubmission(data) {
      return isBoundedString(data.missionId, 1, 128) &&
             isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             data.submissionMode in ['REAL_WORLD_LOG', 'VIRTUAL_PROGRESS'] &&
             isBoundedString(data.reflectionText, 1, 1500) &&
             isBoundedString(data.placeLabel, 1, 120) &&
             (!('photoBase64' in data) || isBoundedString(data.photoBase64, 0, 220000)) &&
             data.ecoSafetyConfirmed == true &&
             isValidTimestamp(data.createdAt);
    }

    function isValidGlobalChallenge(data) {
      return isBoundedString(data.creatorId, 1, 128) &&
             isBoundedString(data.creatorName, 1, 80) &&
             data.challengeScope in ['INDIVIDUAL', 'TEAM', 'INTERNATIONAL'] &&
             isBoundedString(data.category, 2, 48) &&
             isBoundedString(data.title, 2, 120) &&
             isBoundedString(data.description, 4, 600) &&
             data.targetGoal is int && data.targetGoal >= 1 && data.targetGoal <= 500 &&
             isBoundedStringList(data.participantIds, 200, 128) &&
             isBoundedStringList(data.participantCountries, 100, 80) &&
             data.entriesCount is int && data.entriesCount >= 0 && data.entriesCount <= 1000 &&
             isBoundedString(data.cityName, 1, 80) &&
             isBoundedString(data.countryName, 1, 80) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
             data.status in ['ACTIVE', 'COMPLETED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChallengeEntry(data) {
      return isBoundedString(data.challengeId, 1, 128) &&
             isBoundedString(data.authorId, 1, 128) &&
             isBoundedString(data.authorName, 1, 80) &&
             isBoundedString(data.countryName, 1, 80) &&
             (!('teamName' in data) || isBoundedString(data.teamName, 0, 80)) &&
             isBoundedString(data.summaryText, 1, 1000) &&
             data.pointsClaimed is int && data.pointsClaimed >= 1 && data.pointsClaimed <= 10 &&
             data.verificationLabel in ['USER_SUBMITTED', 'PARTICIPANT_CONFIRMED', 'ADMIN_VERIFIED'] &&
             isValidTimestamp(data.createdAt);
    }

    function isValidRealityBridgeLink(data) {
      return isBoundedString(data.userId, 1, 128) &&
             isBoundedString(data.virtualAdventureId, 1, 80) &&
             isBoundedString(data.virtualAdventureTitle, 2, 120) &&
             isBoundedString(data.destinationName, 1, 100) &&
             data.targetType in ['REALITY_EVENT', 'TEAM_ACTIVITY', 'BOOKING_ACTIVITY', 'REAL_WORLD_MISSION', 'NILORA_MEMORY'] &&
             isBoundedString(data.targetId, 1, 128) &&
             isBoundedString(data.targetTitle, 1, 140) &&
             data.stage in ['VIRTUAL', 'PLANNED', 'REGISTERED', 'CONFIRMED', 'COMPLETED'] &&
             (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    match /admin_users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) && isAdmin() && isValidAdminUser(incoming());
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'accountMode', 'preferredLanguage', 'country', 'privacyConsent', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'accountMode', 'preferredLanguage', 'nativeLanguage', 'spokenLanguages', 'learningLanguages', 'interests', 'country', 'city', 'photoUri', 'bio', 'profileVisibility', 'openToLanguageExchange', 'privacyConsent', 'retainTranslationHistory', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accountMode', 'preferredLanguage', 'nativeLanguage', 'spokenLanguages', 'learningLanguages', 'interests', 'country', 'city', 'photoUri', 'bio', 'profileVisibility', 'openToLanguageExchange', 'privacyConsent', 'retainTranslationHistory', 'updatedAt'])));
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /private/{docId} {
        allow get: if isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(docId) && isOwner(userId) && incoming().userId == request.auth.uid && isValidUserPrivateInfo(incoming());
        allow update: if isValidId(docId) && isOwner(userId) && isValidUserPrivateInfo(incoming()) && incoming().userId == existing().userId;
        allow delete: if isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      match /blocked/{blockedUserId} {
        allow get: if isValidId(blockedUserId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(blockedUserId) && isOwner(userId) && incoming().blockerId == request.auth.uid && incoming().blockedUserId == blockedUserId && isValidBlockedUser(incoming());
        allow update: if false;
        allow delete: if isValidId(blockedUserId) && isOwner(userId);
      }

      match /favorites/{favId} {
        allow get: if isValidId(favId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(favId) && isOwner(userId) && incoming().userId == request.auth.uid && isValidFavoriteItem(incoming());
        allow update: if false;
        allow delete: if isValidId(favId) && isOwner(userId);
      }

      match /travel_notes/{noteId} {
        allow get: if isValidId(noteId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(noteId) && isOwner(userId) && incoming().userId == request.auth.uid && isValidTravelNote(incoming());
        allow update: if isValidId(noteId) && isOwner(userId) && isValidTravelNote(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(noteId) && isOwner(userId);
      }

      match /notifications/{notifId} {
        allow get: if isValidId(notifId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(notifId) && isSignedIn() && (isOwner(userId) || isAdmin() || (incoming().category in ['COMMUNITY', 'GROUP', 'EXPERIENCE', 'ADVENTURE', 'REALITY'] && !isBlockedBetween(userId, request.auth.uid))) && incoming().userId == userId && isValidNotification(incoming());
        allow update: if isValidId(notifId) && isOwner(userId) && isValidNotification(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['readStatus']);
        allow delete: if isValidId(notifId) && isOwner(userId);
      }

      match /reality_bridge/{bridgeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(bridgeId) && isOwner(userId) && isValidRealityBridgeLink(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isValidId(bridgeId) && (isOwner(userId) || isAdmin()) && isValidRealityBridgeLink(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(bridgeId) && (isOwner(userId) || isAdmin());
      }
    }

    // Voluntarily discoverable global community profiles
    match /public_profiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (!isBlockedBetween(userId, request.auth.uid) && (
          existing().profileVisibility == 'PUBLIC' ||
          (existing().profileVisibility == 'CONNECTIONS_ONLY' && isConnected(request.auth.uid, userId))
        ))
      );
      allow list: if isSignedIn() && (existing().profileVisibility == 'PUBLIC' || isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) && incoming().userId == request.auth.uid && isValidPublicProfile(incoming());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidPublicProfile(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Global connection / language-exchange requests
    match /connection_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isValidId(requestId) && isSignedIn() && isValidConnectionRequest(incoming()) && incoming().senderId == request.auth.uid && incoming().status == 'PENDING' && !isBlockedBetween(incoming().senderId, incoming().receiverId);
      allow update: if isValidId(requestId) && isSignedIn() && isValidConnectionRequest(incoming()) &&
                       incoming().senderId == existing().senderId &&
                       incoming().receiverId == existing().receiverId &&
                       incoming().memberUids == existing().memberUids &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           existing().status == 'PENDING' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && (
                             (existing().receiverId == request.auth.uid && incoming().status in ['ACCEPTED', 'DECLINED']) ||
                             (existing().senderId == request.auth.uid && incoming().status == 'CANCELLED')
                           )
                         )
                       );
      allow delete: if isValidId(requestId) && isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
    }

    // One-to-one direct conversations & messages
    match /direct_conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && (request.auth.uid in existing().participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().participantIds || isAdmin());
      allow create: if isValidId(conversationId) && isSignedIn() && isValidDirectConversation(incoming()) &&
                       request.auth.uid in incoming().participantIds &&
                       conversationId == pairDocId(incoming().participantIds[0], incoming().participantIds[1]) &&
                       !isBlockedBetween(incoming().participantIds[0], incoming().participantIds[1]);
      allow update: if isValidId(conversationId) && isSignedIn() && isValidDirectConversation(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().createdAt == existing().createdAt &&
                       !isBlockedBetween(existing().participantIds[0], existing().participantIds[1]) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['participantNames', 'participantLanguages', 'lastMessagePreview', 'lastMessageSenderId', 'updatedAt']);
      allow delete: if isValidId(conversationId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(messageId) && isSignedIn() && (request.auth.uid in existing().participantIds || isAdmin());
        allow list: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds
        );
        allow create: if isValidId(messageId) && isSignedIn() && isValidDirectMessage(incoming()) &&
                         incoming().conversationId == conversationId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         exists(/databases/$(database)/documents/direct_conversations/$(conversationId)) &&
                         incoming().participantIds == get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds &&
                         !isBlockedBetween(incoming().participantIds[0], incoming().participantIds[1]);
        allow update: if isValidId(messageId) && isSignedIn() && isValidDirectMessage(incoming()) &&
                         request.auth.uid in existing().participantIds &&
                         incoming().conversationId == existing().conversationId &&
                         incoming().participantIds == existing().participantIds &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationConfidence', 'translationNote']) ||
                           (existing().senderId != request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['deliveryStatus']) && incoming().deliveryStatus in ['DELIVERED', 'READ'])
                         );
        allow delete: if isValidId(messageId) && (isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid));
      }
    }

    // Multilingual community groups
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn() && (
        isAdmin() ||
        request.auth.uid in existing().memberIds ||
        (!(request.auth.uid in existing().bannedIds) && existing().joinPolicy in ['OPEN', 'REQUEST_APPROVAL'])
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid in existing().memberIds ||
        existing().joinPolicy in ['OPEN', 'REQUEST_APPROVAL']
      );
      allow create: if isValidId(groupId) && isSignedIn() && isValidGroupRoom(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberIds &&
                       request.auth.uid in incoming().moderatorIds &&
                       incoming().bannedIds.size() == 0;
      allow update: if isValidId(groupId) && isSignedIn() && isValidGroupRoom(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().ownerId == request.auth.uid ||
                         // Moderator can manage members, bans, and description while keeping owner in room
                         (request.auth.uid in existing().moderatorIds &&
                          existing().ownerId in incoming().memberIds &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'bannedIds', 'description', 'updatedAt'])) ||
                         // Non-banned user joining OPEN group (only adding self)
                         (existing().joinPolicy == 'OPEN' &&
                          !(request.auth.uid in existing().bannedIds) &&
                          !(request.auth.uid in existing().memberIds) &&
                          request.auth.uid in incoming().memberIds &&
                          incoming().memberIds.size() == existing().memberIds.size() + 1 &&
                          incoming().memberIds.hasAll(existing().memberIds) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])) ||
                         // Non-owner member leaving group (only removing self)
                         (request.auth.uid in existing().memberIds &&
                          request.auth.uid != existing().ownerId &&
                          !(request.auth.uid in incoming().memberIds) &&
                          existing().memberIds.hasAll(incoming().memberIds) &&
                          incoming().memberIds.size() == existing().memberIds.size() - 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt']))
                       );
      allow delete: if isValidId(groupId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      match /join_requests/{reqId} {
        allow get: if isValidId(reqId) && isSignedIn() && (isOwner(reqId) || isGroupModeratorOrOwner(groupId) || isAdmin());
        allow list: if isSignedIn() && (existing().userId == request.auth.uid || isGroupModeratorOrOwner(groupId) || isAdmin());
        allow create: if isValidId(reqId) && isSignedIn() && isValidGroupJoinRequest(incoming()) &&
                         incoming().groupId == groupId &&
                         incoming().userId == reqId &&
                         incoming().status == 'PENDING' && (
                           (reqId == request.auth.uid && incoming().requestType == 'JOIN_REQUEST') ||
                           (isGroupModeratorOrOwner(groupId) && incoming().requestType == 'INVITE')
                         );
        allow update: if isValidId(reqId) && isSignedIn() && isValidGroupJoinRequest(incoming()) &&
                         incoming().groupId == existing().groupId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && (
                           isAdmin() ||
                           isGroupModeratorOrOwner(groupId) ||
                           (reqId == request.auth.uid && existing().requestType == 'INVITE' && incoming().status in ['APPROVED', 'DECLINED'])
                         );
        allow delete: if isValidId(reqId) && isSignedIn() && (isOwner(reqId) || isGroupModeratorOrOwner(groupId) || isAdmin());
      }

      match /messages/{messageId} {
        allow get: if isValidId(messageId) && isSignedIn() && (isGroupMember(groupId) || isAdmin());
        allow list: if isSignedIn() && (isGroupMember(groupId) || isAdmin());
        allow create: if isValidId(messageId) && isSignedIn() && isGroupMember(groupId) && isValidGroupMessage(incoming()) && incoming().groupId == groupId && incoming().senderId == request.auth.uid;
        allow update: if isValidId(messageId) && isSignedIn() && isGroupMember(groupId) && isValidGroupMessage(incoming()) &&
                         incoming().groupId == existing().groupId &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote']);
        allow delete: if isValidId(messageId) && isSignedIn() && (isAdmin() || isGroupModeratorOrOwner(groupId) || existing().senderId == request.auth.uid);
      }
    }

    match /countries/{countryId} {
      allow get: if isValidId(countryId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(countryId) && isAdmin() && isValidCountry(incoming());
      allow delete: if isValidId(countryId) && isAdmin();
    }

    match /cities/{cityId} {
      allow get: if isValidId(cityId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(cityId) && isAdmin() && isValidCity(incoming());
      allow delete: if isValidId(cityId) && isAdmin();
    }

    match /destinations/{destinationId} {
      allow get: if isValidId(destinationId) && isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().submittedBy == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().submittedBy == request.auth.uid || isAdmin());
      allow create: if isValidId(destinationId) && isSignedIn() && isValidDestination(incoming()) && incoming().submittedBy == request.auth.uid && (isAdmin() || incoming().verificationStatus == 'PENDING');
      allow update: if isValidId(destinationId) && isSignedIn() && isValidDestination(incoming()) && incoming().submittedBy == existing().submittedBy && incoming().createdAt == existing().createdAt && (isAdmin() || (existing().submittedBy == request.auth.uid && incoming().verificationStatus == existing().verificationStatus));
      allow delete: if isValidId(destinationId) && isAdmin();
    }

    match /activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().providerId == request.auth.uid || isAdmin());
      allow create: if isValidId(activityId) && isSignedIn() && isValidActivity(incoming()) && incoming().providerId == request.auth.uid && (isAdmin() || (isApprovedProvider(request.auth.uid) && incoming().verificationStatus == 'PENDING'));
      allow update: if isValidId(activityId) && isSignedIn() && isValidActivity(incoming()) && incoming().providerId == existing().providerId && incoming().createdAt == existing().createdAt && (isAdmin() || (existing().providerId == request.auth.uid && incoming().verificationStatus == existing().verificationStatus && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'durationLabel', 'priceAmount', 'currency', 'priceOnRequest', 'availabilityStatus', 'includedServices', 'exclusions', 'cancellationPolicy', 'safetyRequirements', 'updatedAt'])));
      allow delete: if isValidId(activityId) && isAdmin();
    }

    match /providers/{providerId} {
      allow get: if isValidId(providerId) && isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().verificationStatus == 'APPROVED' || existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(providerId) && isSignedIn() && providerId == request.auth.uid && incoming().userId == request.auth.uid && isValidProvider(incoming()) && (isAdmin() || incoming().verificationStatus == 'PENDING');
      allow update: if isValidId(providerId) && isSignedIn() && isValidProvider(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().verificationStatus == 'PENDING' && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'serviceType', 'languages', 'citiesCovered', 'bio', 'licenseNumber', 'documentSummary', 'documentRefUri', 'verificationStatus', 'updatedAt']))
      );
      allow delete: if isValidId(providerId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().travelerId == request.auth.uid || existing().providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().travelerId == request.auth.uid || existing().providerId == request.auth.uid || isAdmin());
      allow create: if isValidId(bookingId) && isSignedIn() && isValidBooking(incoming()) && incoming().travelerId == request.auth.uid && incoming().status in ['REQUEST_SUBMITTED', 'AWAITING_PROVIDER_CONFIRMATION'] && incoming().paymentStatus in ['NOT_CONFIGURED', 'PENDING'];
      allow update: if isValidId(bookingId) && isSignedIn() && isValidBooking(incoming()) && incoming().travelerId == existing().travelerId && incoming().providerId == existing().providerId && incoming().activityId == existing().activityId && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (!(existing().status in ['CANCELLED', 'REJECTED']) && (
          (existing().travelerId == request.auth.uid && incoming().status == 'CANCELLED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt'])) ||
          (existing().providerId == request.auth.uid && incoming().status in ['AWAITING_PROVIDER_CONFIRMATION', 'CONFIRMED', 'REJECTED'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']))
        ))
      );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /conversation_rooms/{roomId} {
      allow get: if isValidId(roomId) && isSignedIn() && (request.auth.uid in existing().memberUids || (existing().status == 'WAITING' && existing().memberUids.size() < 2) || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
      allow create: if isValidId(roomId) && isSignedIn() && isValidConversationRoom(incoming()) && incoming().hostId == request.auth.uid && incoming().memberUids.size() == 1 && request.auth.uid in incoming().memberUids && incoming().status == 'WAITING';
      allow update: if isValidId(roomId) && isSignedIn() && isValidConversationRoom(incoming()) && incoming().hostId == existing().hostId && incoming().roomCode == existing().roomCode && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (existing().status == 'WAITING' && existing().memberUids.size() == 1 && !(request.auth.uid in existing().memberUids) && incoming().memberUids.size() == 2 && request.auth.uid in incoming().memberUids && existing().hostId in incoming().memberUids && incoming().guestId == request.auth.uid && incoming().status == 'ACTIVE' && incoming().diff(existing()).affectedKeys().hasOnly(['guestId', 'guestName', 'guestLanguage', 'memberUids', 'status', 'updatedAt'])) ||
        (request.auth.uid in existing().memberUids && existing().status != 'ENDED' && incoming().memberUids == existing().memberUids && incoming().diff(existing()).affectedKeys().hasOnly(['hostLanguage', 'guestLanguage', 'status', 'retainTranscript', 'updatedAt']))
      );
      allow delete: if isValidId(roomId) && (isOwner(existing().hostId) || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(messageId) && isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids || isAdmin());
        allow create: if isValidId(messageId) && isSignedIn() && isValidConversationMessage(incoming()) && incoming().senderId == request.auth.uid && request.auth.uid in incoming().memberUids && exists(/databases/$(database)/documents/conversation_rooms/$(roomId)) && request.auth.uid in get(/databases/$(database)/documents/conversation_rooms/$(roomId)).data.memberUids;
        allow update: if false;
        allow delete: if isValidId(messageId) && (isAdmin() || (isSignedIn() && request.auth.uid in existing().memberUids));
      }
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId) && isSignedIn() && isValidReport(incoming()) && incoming().reporterId == request.auth.uid && incoming().status == 'OPEN';
      allow update: if isValidId(reportId) && isAdmin() && isValidReport(incoming()) && incoming().reporterId == existing().reporterId && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /data_sources/{sourceId} {
      allow get: if isValidId(sourceId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(sourceId) && isAdmin() && isValidDataSource(incoming());
      allow delete: if isValidId(sourceId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming()) && incoming().actorId == request.auth.uid && (isAdmin() || incoming().severity == 'INFO');
      allow update, delete: if false;
    }

    // --- NEXT-GEN HUMAN CONNECTION: WORLD POSTCARD, CULTURE SWAP, WORLD QUEST, NILORA MEMORY ---

    match /world_postcards/{postcardId} {
      allow get: if isValidId(postcardId) && isSignedIn() && (
        isAdmin() ||
        existing().authorId == request.auth.uid ||
        (!isBlockedBetween(existing().authorId, request.auth.uid) && (
          existing().visibility == 'PUBLIC' ||
          request.auth.uid in existing().participantIds
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().visibility == 'PUBLIC' ||
        existing().authorId == request.auth.uid ||
        request.auth.uid in existing().participantIds
      );
      allow create: if isValidId(postcardId) && isSignedIn() && isValidWorldPostcard(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().contributionsCount == 0;
      allow update: if isValidId(postcardId) && isSignedIn() && isValidWorldPostcard(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().authorId == request.auth.uid ||
                         (!isBlockedBetween(existing().authorId, request.auth.uid) && existing().visibility == 'PUBLIC' && (
                           (existing().allowReplies == true &&
                            incoming().participantIds.hasAll(existing().participantIds) &&
                            request.auth.uid in incoming().participantIds &&
                            incoming().contributionsCount == existing().contributionsCount + 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'countriesChain', 'contributionsCount', 'updatedAt'])) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote'])
                         ))
                       );
      allow delete: if isValidId(postcardId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      match /contributions/{contributionId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/world_postcards/$(postcardId)) && (
          isAdmin() ||
          get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.authorId == request.auth.uid ||
          (!isBlockedBetween(get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.authorId, request.auth.uid) && (
            get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.visibility == 'PUBLIC' ||
            request.auth.uid in get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.participantIds
          ))
        );
        allow create: if isValidId(contributionId) && isSignedIn() && isValidPostcardContribution(incoming()) &&
                         incoming().postcardId == postcardId &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/world_postcards/$(postcardId)) &&
                         get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.allowReplies == true &&
                         get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.visibility == 'PUBLIC' &&
                         !isBlockedBetween(get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.authorId, request.auth.uid);
        allow update: if isValidId(contributionId) && isSignedIn() && isValidPostcardContribution(incoming()) &&
                         incoming().postcardId == existing().postcardId &&
                         incoming().authorId == existing().authorId &&
                         incoming().responseText == existing().responseText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote']);
        allow delete: if isValidId(contributionId) && isSignedIn() && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/world_postcards/$(postcardId)).data.authorId == request.auth.uid
        );
      }
    }

    match /culture_swaps/{swapId} {
      allow get: if isValidId(swapId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        (!isBlockedBetween(existing().creatorId, request.auth.uid) && existing().status in ['OPEN', 'EXCHANGED', 'COMPLETED'])
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        existing().status in ['OPEN', 'EXCHANGED', 'COMPLETED']
      );
      allow create: if isValidId(swapId) && isSignedIn() && isValidCultureSwap(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds;
      allow update: if isValidId(swapId) && isSignedIn() && isValidCultureSwap(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().creatorId == request.auth.uid ||
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) &&
                          incoming().participantIds.hasAll(existing().participantIds) &&
                          request.auth.uid in incoming().participantIds &&
                          incoming().participantIds.size() <= existing().maxParticipants &&
                          incoming().entriesCount >= existing().entriesCount &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'participantCountries', 'entriesCount', 'status', 'updatedAt']))
                       );
      allow delete: if isValidId(swapId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /entries/{entryId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/culture_swaps/$(swapId)) && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.participantIds ||
          !isBlockedBetween(get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.creatorId, request.auth.uid)
        );
        allow create: if isValidId(entryId) && isSignedIn() && isValidCultureSwapEntry(incoming()) &&
                         incoming().swapId == swapId &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/culture_swaps/$(swapId)) &&
                         !isBlockedBetween(get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.creatorId, request.auth.uid) &&
                         (request.auth.uid in get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.participantIds ||
                          get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.participantIds.size() < get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.maxParticipants);
        allow update: if isValidId(entryId) && isSignedIn() && isValidCultureSwapEntry(incoming()) &&
                         incoming().swapId == existing().swapId &&
                         incoming().authorId == existing().authorId &&
                         incoming().contentText == existing().contentText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote']);
        allow delete: if isValidId(entryId) && isSignedIn() && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/culture_swaps/$(swapId)).data.creatorId == request.auth.uid
        );
      }
    }

    match /world_quests/{questId} {
      allow get: if isValidId(questId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        (!isBlockedBetween(existing().creatorId, request.auth.uid) && existing().status in ['ACTIVE', 'COMPLETED'])
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        existing().status in ['ACTIVE', 'COMPLETED']
      );
      allow create: if isValidId(questId) && isSignedIn() && isValidWorldQuest(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().contributionsCount == 0 &&
                       incoming().status == 'ACTIVE';
      allow update: if isValidId(questId) && isSignedIn() && isValidWorldQuest(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().targetGoal == existing().targetGoal &&
                       incoming().createdAt == existing().createdAt &&
                       (incoming().status != 'COMPLETED' || incoming().contributionsCount >= existing().targetGoal) && (
                         isAdmin() ||
                         existing().creatorId == request.auth.uid ||
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) &&
                          incoming().participantIds.hasAll(existing().participantIds) &&
                          request.auth.uid in incoming().participantIds &&
                          incoming().contributionsCount <= existing().contributionsCount + 1 &&
                          incoming().contributionsCount >= existing().contributionsCount &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantCountries', 'contributionsCount', 'status', 'updatedAt']))
                       );
      allow delete: if isValidId(questId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /contributions/{contributionId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/world_quests/$(questId)) && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/world_quests/$(questId)).data.participantIds ||
          !isBlockedBetween(get(/databases/$(database)/documents/world_quests/$(questId)).data.creatorId, request.auth.uid)
        );
        allow create: if isValidId(contributionId) && isSignedIn() && isValidWorldQuestContribution(incoming()) &&
                         incoming().questId == questId &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/world_quests/$(questId)) &&
                         !isBlockedBetween(get(/databases/$(database)/documents/world_quests/$(questId)).data.creatorId, request.auth.uid);
        allow update: if isValidId(contributionId) && isSignedIn() && isValidWorldQuestContribution(incoming()) &&
                         incoming().questId == existing().questId &&
                         incoming().authorId == existing().authorId &&
                         incoming().contentText == existing().contentText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote']);
        allow delete: if isValidId(contributionId) && isSignedIn() && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/world_quests/$(questId)).data.creatorId == request.auth.uid
        );
      }
    }

    match /nilora_memories/{memoryId} {
      allow get: if isValidId(memoryId) && isSignedIn() && (
        isAdmin() ||
        existing().ownerId == request.auth.uid ||
        (!isBlockedBetween(existing().ownerId, request.auth.uid) && (
          existing().visibility == 'PUBLIC' ||
          (existing().visibility == 'SHARED_WITH_PARTICIPANTS' && request.auth.uid in existing().partnerIds)
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().ownerId == request.auth.uid ||
        existing().visibility == 'PUBLIC' ||
        (existing().visibility == 'SHARED_WITH_PARTICIPANTS' && request.auth.uid in existing().partnerIds)
      );
      allow create: if isValidId(memoryId) && isSignedIn() && isValidNiloraMemory(incoming()) &&
                       incoming().ownerId == request.auth.uid;
      allow update: if isValidId(memoryId) && isSignedIn() && isValidNiloraMemory(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().ownerId == request.auth.uid ||
                         (existing().visibility == 'SHARED_WITH_PARTICIPANTS' &&
                          request.auth.uid in existing().partnerIds &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['translations']))
                       );
      allow delete: if isValidId(memoryId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // --- NILORA LIVE WORLDS: ADVENTURE SESSIONS, MATCHMAKING & CREWS ---

    match /adventure_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (
        isAdmin() ||
        existing().hostId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        (!isBlockedBetween(existing().hostId, request.auth.uid) && (
          (existing().status == 'ACTIVE' && existing().mode == 'JOIN_OTHERS') ||
          ('crewId' in existing() && existing().crewId != '' && isCrewMember(existing().crewId))
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().hostId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        (existing().status == 'ACTIVE' && existing().mode == 'JOIN_OTHERS')
      );
      allow create: if isValidId(sessionId) && isSignedIn() && isValidLiveAdventureSession(incoming()) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().status == 'ACTIVE';
      allow update: if isValidId(sessionId) && isSignedIn() && isValidLiveAdventureSession(incoming()) &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().hostId == request.auth.uid ||
                         // Join open or crew session (adding only self)
                         (existing().status == 'ACTIVE' &&
                          !isBlockedBetween(existing().hostId, request.auth.uid) &&
                          (existing().mode == 'JOIN_OTHERS' || ('crewId' in existing() && existing().crewId != '' && isCrewMember(existing().crewId))) &&
                          !(request.auth.uid in existing().participantIds) &&
                          request.auth.uid in incoming().participantIds &&
                          incoming().participantIds.hasAll(existing().participantIds) &&
                          incoming().participantIds.size() == existing().participantIds.size() + 1 &&
                          incoming().participantIds.size() <= existing().maxParticipants &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'participantCountries', 'participantLanguages', 'updatedAt'])) ||
                         // Leave session (non-host removing only self)
                         (request.auth.uid in existing().participantIds &&
                          request.auth.uid != existing().hostId &&
                          !(request.auth.uid in incoming().participantIds) &&
                          existing().participantIds.hasAll(incoming().participantIds) &&
                          incoming().participantIds.size() == existing().participantIds.size() - 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'participantCountries', 'participantLanguages', 'updatedAt']))
                       );
      allow delete: if isValidId(sessionId) && isSignedIn() && (existing().hostId == request.auth.uid || isAdmin());

      match /participants/{participantId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.participantIds ||
          get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.mode == 'JOIN_OTHERS'
        );
        allow create, update: if isValidId(participantId) && isOwner(participantId) && isValidSessionParticipantPresence(incoming()) &&
                                 incoming().sessionId == sessionId &&
                                 incoming().userId == request.auth.uid &&
                                 exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) &&
                                 request.auth.uid in get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.participantIds;
        allow delete: if isValidId(participantId) && isSignedIn() && (
          isOwner(participantId) ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) &&
           get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.hostId == request.auth.uid)
        );
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.participantIds ||
          get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.mode == 'JOIN_OTHERS'
        );
        allow create: if isValidId(messageId) && isSignedIn() && isValidSessionChatMessage(incoming()) &&
                         incoming().sessionId == sessionId &&
                         incoming().senderId == request.auth.uid &&
                         exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.participantIds;
        allow update: if isValidId(messageId) && isSignedIn() && isValidSessionChatMessage(incoming()) &&
                         incoming().sessionId == existing().sessionId &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt &&
                         request.auth.uid in get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.participantIds &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations', 'translationNote']);
        allow delete: if isValidId(messageId) && isSignedIn() && (
          isAdmin() ||
          existing().senderId == request.auth.uid ||
          (exists(/databases/$(database)/documents/adventure_sessions/$(sessionId)) &&
           get(/databases/$(database)/documents/adventure_sessions/$(sessionId)).data.hostId == request.auth.uid)
        );
      }
    }

    match /adventure_match_profiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (!isBlockedBetween(userId, request.auth.uid) && existing().isAvailable == true)
      );
      allow list: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        existing().isAvailable == true
      );
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidAdventureMatchProfile(incoming()) &&
                               incoming().userId == request.auth.uid;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /nilora_crews/{crewId} {
      allow get: if isValidId(crewId) && isSignedIn() && (
        isAdmin() ||
        existing().leaderId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        (!isBlockedBetween(existing().leaderId, request.auth.uid) && existing().joinPolicy == 'OPEN')
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().leaderId == request.auth.uid ||
        request.auth.uid in existing().memberIds ||
        existing().joinPolicy == 'OPEN'
      );
      allow create: if isValidId(crewId) && isSignedIn() && isValidNiloraCrew(incoming()) &&
                       incoming().leaderId == request.auth.uid &&
                       request.auth.uid in incoming().memberIds;
      allow update: if isValidId(crewId) && isSignedIn() && isValidNiloraCrew(incoming()) &&
                       incoming().leaderId == existing().leaderId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().leaderId == request.auth.uid ||
                         // Existing crew member updating adventure history or planned trips or leaving
                         (request.auth.uid in existing().memberIds && (
                           incoming().diff(existing()).affectedKeys().hasOnly(['plannedAdventureIds', 'adventureHistoryTitles', 'updatedAt']) ||
                           (request.auth.uid != existing().leaderId &&
                            !(request.auth.uid in incoming().memberIds) &&
                            existing().memberIds.hasAll(incoming().memberIds) &&
                            incoming().memberIds.size() == existing().memberIds.size() - 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'memberNames', 'memberCountries', 'updatedAt']))
                         )) ||
                         // Join OPEN crew (adding only self)
                         (existing().joinPolicy == 'OPEN' &&
                          !isBlockedBetween(existing().leaderId, request.auth.uid) &&
                          !(request.auth.uid in existing().memberIds) &&
                          request.auth.uid in incoming().memberIds &&
                          incoming().memberIds.hasAll(existing().memberIds) &&
                          incoming().memberIds.size() == existing().memberIds.size() + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'memberNames', 'memberCountries', 'updatedAt']))
                       );
      allow delete: if isValidId(crewId) && isSignedIn() && (existing().leaderId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (isAdmin() || isCrewMember(crewId));
        allow create: if isValidId(messageId) && isSignedIn() && isCrewMember(crewId) &&
                         isValidCrewMessage(incoming()) &&
                         incoming().crewId == crewId &&
                         incoming().senderId == request.auth.uid;
        allow update: if isValidId(messageId) && isSignedIn() && isCrewMember(crewId) &&
                         isValidCrewMessage(incoming()) &&
                         incoming().crewId == existing().crewId &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations']);
        allow delete: if isValidId(messageId) && isSignedIn() && (isAdmin() || existing().senderId == request.auth.uid);
      }
    }

    // --- PHASE 2 REALITY CONNECTED UNIVERSE COLLECTIONS ---

    match /reality_events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        !isBlockedBetween(existing().creatorId, request.auth.uid)
      );
      allow list: if isSignedIn();
      allow create: if isValidId(eventId) && isSignedIn() && isValidRealityEvent(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().pendingRequestIds.size() == 0 &&
                       (isAdmin() || incoming().verificationTier == 'UNVERIFIED_USER_SUBMITTED');
      allow update: if isValidId(eventId) && isSignedIn() && isValidRealityEvent(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().creatorId == request.auth.uid &&
                          incoming().verificationTier == existing().verificationTier) ||
                         // Join OPEN event or submit join request for REQUEST_APPROVAL event
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) &&
                          existing().status in ['UPCOMING', 'ACTIVE'] && (
                            (existing().joinPolicy == 'OPEN' &&
                             !(request.auth.uid in existing().participantIds) &&
                             request.auth.uid in incoming().participantIds &&
                             incoming().participantIds.hasAll(existing().participantIds) &&
                             incoming().participantIds.size() == existing().participantIds.size() + 1 &&
                             incoming().participantIds.size() <= existing().maxParticipants &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'updatedAt'])) ||
                            (existing().joinPolicy == 'REQUEST_APPROVAL' &&
                             !(request.auth.uid in existing().pendingRequestIds) &&
                             request.auth.uid in incoming().pendingRequestIds &&
                             incoming().pendingRequestIds.hasAll(existing().pendingRequestIds) &&
                             incoming().pendingRequestIds.size() == existing().pendingRequestIds.size() + 1 &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['pendingRequestIds', 'updatedAt'])) ||
                            (request.auth.uid in existing().participantIds &&
                             request.auth.uid != existing().creatorId &&
                             !(request.auth.uid in incoming().participantIds) &&
                             existing().participantIds.hasAll(incoming().participantIds) &&
                             incoming().participantIds.size() == existing().participantIds.size() - 1 &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'updatedAt']))
                          ))
                       );
      allow delete: if isValidId(eventId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (isAdmin() || isEventParticipant(eventId));
        allow create: if isValidId(messageId) && isSignedIn() && isEventParticipant(eventId) &&
                         isValidRealityEventMessage(incoming()) &&
                         incoming().eventId == eventId &&
                         incoming().senderId == request.auth.uid;
        allow update: if isValidId(messageId) && isSignedIn() && isEventParticipant(eventId) &&
                         isValidRealityEventMessage(incoming()) &&
                         incoming().eventId == existing().eventId &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations']);
        allow delete: if isValidId(messageId) && isSignedIn() && (
          isAdmin() ||
          existing().senderId == request.auth.uid ||
          get(/databases/$(database)/documents/reality_events/$(eventId)).data.creatorId == request.auth.uid
        );
      }
    }

    match /reality_activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        (!isBlockedBetween(existing().creatorId, request.auth.uid) && (
          existing().joinPolicy in ['PUBLIC', 'REQUEST_APPROVAL'] ||
          request.auth.uid in existing().invitedUserIds
        ))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        request.auth.uid in existing().participantIds ||
        existing().joinPolicy in ['PUBLIC', 'REQUEST_APPROVAL']
      );
      allow create: if isValidId(activityId) && isSignedIn() && isValidTeamActivityPost(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().pendingRequestIds.size() == 0 &&
                       (isAdmin() || incoming().impactVerifiedByAdmin == false);
      allow update: if isValidId(activityId) && isSignedIn() && isValidTeamActivityPost(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().creatorId == request.auth.uid &&
                          incoming().impactVerifiedByAdmin == existing().impactVerifiedByAdmin) ||
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) && (
                           // Join PUBLIC or INVITE_ONLY (when invited)
                           ((existing().joinPolicy == 'PUBLIC' ||
                             (existing().joinPolicy == 'INVITE_ONLY' && request.auth.uid in existing().invitedUserIds)) &&
                            existing().teamStatus in ['LOOKING_FOR_PARTICIPANTS', 'GROUP_FORMING'] &&
                            !(request.auth.uid in existing().participantIds) &&
                            request.auth.uid in incoming().participantIds &&
                            incoming().participantIds.hasAll(existing().participantIds) &&
                            incoming().participantIds.size() == existing().participantIds.size() + 1 &&
                            incoming().participantIds.size() <= existing().maxParticipants &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'teamStatus', 'updatedAt'])) ||
                           // Submit request for REQUEST_APPROVAL
                           (existing().joinPolicy == 'REQUEST_APPROVAL' &&
                            existing().teamStatus in ['LOOKING_FOR_PARTICIPANTS', 'GROUP_FORMING'] &&
                            !(request.auth.uid in existing().participantIds) &&
                            !(request.auth.uid in existing().pendingRequestIds) &&
                            request.auth.uid in incoming().pendingRequestIds &&
                            incoming().pendingRequestIds.hasAll(existing().pendingRequestIds) &&
                            incoming().pendingRequestIds.size() == existing().pendingRequestIds.size() + 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['pendingRequestIds', 'updatedAt'])) ||
                           // Leave group
                           (request.auth.uid in existing().participantIds &&
                            request.auth.uid != existing().creatorId &&
                            !(request.auth.uid in incoming().participantIds) &&
                            existing().participantIds.hasAll(incoming().participantIds) &&
                            incoming().participantIds.size() == existing().participantIds.size() - 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantNames', 'teamStatus', 'updatedAt']))
                         ))
                       );
      allow delete: if isValidId(activityId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (isAdmin() || isActivityParticipant(activityId));
        allow create: if isValidId(messageId) && isSignedIn() && isActivityParticipant(activityId) &&
                         isValidActivityGroupMessage(incoming()) &&
                         incoming().activityId == activityId &&
                         incoming().senderId == request.auth.uid;
        allow update: if isValidId(messageId) && isSignedIn() && isActivityParticipant(activityId) &&
                         isValidActivityGroupMessage(incoming()) &&
                         incoming().activityId == existing().activityId &&
                         incoming().senderId == existing().senderId &&
                         incoming().originalText == existing().originalText &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['translations']);
        allow delete: if isValidId(messageId) && isSignedIn() && (
          isAdmin() ||
          existing().senderId == request.auth.uid ||
          get(/databases/$(database)/documents/reality_activities/$(activityId)).data.creatorId == request.auth.uid
        );
      }
    }

    match /reality_missions/{missionId} {
      allow get: if isValidId(missionId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        !isBlockedBetween(existing().creatorId, request.auth.uid)
      );
      allow list: if isSignedIn();
      allow create: if isValidId(missionId) && isSignedIn() && isValidRealityMission(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().submissionsCount == 0 &&
                       incoming().status == 'ACTIVE';
      allow update: if isValidId(missionId) && isSignedIn() && isValidRealityMission(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().executionMode == existing().executionMode &&
                       incoming().targetSteps == existing().targetSteps &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().creatorId == request.auth.uid ||
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) &&
                          incoming().participantIds.hasAll(existing().participantIds) &&
                          request.auth.uid in incoming().participantIds &&
                          incoming().submissionsCount >= existing().submissionsCount &&
                          incoming().submissionsCount <= existing().submissionsCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'submissionsCount', 'status', 'updatedAt']))
                       );
      allow delete: if isValidId(missionId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /submissions/{submissionId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/reality_missions/$(missionId)) && (
          isAdmin() ||
          !isBlockedBetween(get(/databases/$(database)/documents/reality_missions/$(missionId)).data.creatorId, request.auth.uid)
        );
        allow create: if isValidId(submissionId) && isSignedIn() && isValidMissionSubmission(incoming()) &&
                         incoming().missionId == missionId &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/reality_missions/$(missionId)) &&
                         !isBlockedBetween(get(/databases/$(database)/documents/reality_missions/$(missionId)).data.creatorId, request.auth.uid) &&
                         // Virtual missions can NEVER record a REAL_WORLD_LOG
                         (get(/databases/$(database)/documents/reality_missions/$(missionId)).data.executionMode == 'REAL_WORLD' ||
                          incoming().submissionMode == 'VIRTUAL_PROGRESS');
        allow update: if false;
        allow delete: if isValidId(submissionId) && isSignedIn() && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/reality_missions/$(missionId)).data.creatorId == request.auth.uid
        );
      }
    }

    match /global_challenges/{challengeId} {
      allow get: if isValidId(challengeId) && isSignedIn() && (
        isAdmin() ||
        existing().creatorId == request.auth.uid ||
        !isBlockedBetween(existing().creatorId, request.auth.uid)
      );
      allow list: if isSignedIn();
      allow create: if isValidId(challengeId) && isSignedIn() && isValidGlobalChallenge(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().participantIds.size() == 1 &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().entriesCount == 0 &&
                       incoming().status == 'ACTIVE';
      allow update: if isValidId(challengeId) && isSignedIn() && isValidGlobalChallenge(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().targetGoal == existing().targetGoal &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().creatorId == request.auth.uid ||
                         (!isBlockedBetween(existing().creatorId, request.auth.uid) &&
                          incoming().participantIds.hasAll(existing().participantIds) &&
                          request.auth.uid in incoming().participantIds &&
                          incoming().entriesCount >= existing().entriesCount &&
                          incoming().entriesCount <= existing().entriesCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'participantCountries', 'entriesCount', 'status', 'updatedAt']))
                       );
      allow delete: if isValidId(challengeId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /entries/{entryId} {
        allow get, list: if isSignedIn() && exists(/databases/$(database)/documents/global_challenges/$(challengeId)) && (
          isAdmin() ||
          !isBlockedBetween(get(/databases/$(database)/documents/global_challenges/$(challengeId)).data.creatorId, request.auth.uid)
        );
        allow create: if isValidId(entryId) && isSignedIn() && isValidChallengeEntry(incoming()) &&
                         incoming().challengeId == challengeId &&
                         incoming().authorId == request.auth.uid &&
                         (isAdmin() || incoming().verificationLabel == 'USER_SUBMITTED') &&
                         exists(/databases/$(database)/documents/global_challenges/$(challengeId)) &&
                         !isBlockedBetween(get(/databases/$(database)/documents/global_challenges/$(challengeId)).data.creatorId, request.auth.uid);
        allow update: if isValidId(entryId) && isAdmin() && isValidChallengeEntry(incoming()) &&
                         incoming().challengeId == existing().challengeId &&
                         incoming().authorId == existing().authorId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(entryId) && isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);
      }
    }
  }
}
