             isBoundedString(data.targetAdventureId, 1, 80) &&
             isBoundedString(data.targetDestination, 1, 100) &&
             (!('interests' in data) || isBoundedStringList(data.interests, 15, 40)) &&
             isBoundedString(data.preferredLanguage, 1, 16) &&
             isBoundedStringList(data.spokenLanguages, 15, 20) &&
             data.experienceLevel in ['BEGINNER', 'INTERMEDIATE', 'EXPLORER'] &&
             data.preferredDurationMinutes is int && data.preferredDurationMinutes >= 5 && data.preferredDurationMinutes <= 180 &&
             isBoundedString(data.availableTimeSlot, 1, 80) &&
             data.voicePreferred is bool &&
             data.isAvailable is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNiloraCrew(data) {
      return isBoundedString(data.name, 2, 80) &&
             (!('description' in data) || isBoundedString(data.description, 0, 400)) &&
             isBoundedString(data.leaderId, 1, 128) &&
             isBoundedStringList(data.memberIds, 30, 128) &&
             data.leaderId in data.memberIds &&
             data.memberNames is map && data.memberNames.size() <= 30 &&
             data.memberCountries is map && data.memberCountries.size() <= 30 &&
             (!('sharedInterests' in data) || isBoundedStringList(data.sharedInterests, 15, 40)) &&
             isBoundedString(data.focusDestination, 1, 100) &&
             (!('plannedAdventureIds' in data) || isBoundedStringList(data.plannedAdventureIds, 20, 80)) &&
             (!('adventureHistoryTitles' in data) || isBoundedStringList(data.adventureHistoryTitles, 30, 120)) &&
             data.joinPolicy in ['OPEN', 'INVITE_ONLY'] &&
             data.voiceChannelEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCrewMessage(data) {
      return isBoundedString(data.crewId, 1, 128) &&
             isBoundedString(data.senderId, 1, 128) &&
             isBoundedString(data.senderName, 1, 80) &&
             isBoundedString(data.originalText, 1, 1500) &&
             isBoundedString(data.sourceLanguage, 1, 16) &&
             (!('translations' in data) || (data.translations is map && data.translations.size() <= 20)) &&
             isValidTimestamp(data.createdAt);
